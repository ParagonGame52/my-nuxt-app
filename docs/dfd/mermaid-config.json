    "primaryColor": "#dbeafe",
    "primaryTextColor": "#1e3a8a",
    "primaryBorderColor": "#1d4ed8",
    "secondaryColor": "#f8fafc",
    "secondaryTextColor": "#334155",
    "secondaryBorderColor": "#334155",
    "tertiaryColor": "#fff7ed",
